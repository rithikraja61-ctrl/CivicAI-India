# ==============================================================================
# CivicAI-India Environment Configuration
# ==============================================================================

# 1. Google Gemini AI API Key (Mandatory for live Google AI Studio / Vertex AI)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Maps Platform API Key (Optional for Places Autocomplete / Geocoding SDK)
# Get your key at: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 3. Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod
